{
  "name": "myvault",
  "version": "1.0.0",
  "private": true,
  "description": "MyVault — a local-first, end-to-end encrypted personal password manager (web app + Chrome MV3 extension).",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --config vite.web.config.ts",
    "build": "npm run build:web && npm run build:ext",
    "build:web": "tsc -p tsconfig.json --noEmit && vite build --config vite.web.config.ts",
    "build:ext": "node scripts/build-extension.mjs",
    "preview": "vite preview --config vite.web.config.ts --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm test && npm run build && npm run test:e2e",
    "decrypt-backup": "node scripts/decrypt-backup.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@zxcvbn-ts/core": "3.0.4",
    "@zxcvbn-ts/language-common": "3.0.4",
    "@zxcvbn-ts/language-en": "3.0.2",
    "hash-wasm": "4.12.0",
    "lucide-react": "1.66.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tldts": "7.4.19"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/chrome": "0.3.7",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "fake-indexeddb": "6.2.7",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
